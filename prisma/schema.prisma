// Data model for the multi-tenant Trade Show System.
//
// Naming: a customer "account" (a company that signs up) is called
// `Organization` in code, so it never clashes with Auth.js' own `Account`
// table if social login is added later. The UI calls it "account".

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection, used by the app
  directUrl = env("DATABASE_URL_UNPOOLED") // direct connection, used for migrations
  // Trigram indexes, so searching for any part of a name stays fast with many rows.
  extensions = [pg_trgm]
}

// ---------------------------------------------------------------------------
// People and tenancy
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  passwordHash   String?
  emailVerified  DateTime?
  // Gets the daily email about what is new on the saved lists of their accounts.
  listEmails     Boolean   @default(true)
  // Goes up by one on every login. A session made before the latest login no
  // longer matches and is logged out, so one login can't be used in two places.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships     Membership[]
  invitationsSent Invitation[]     @relation("InvitedBy")
  savedListItems  SavedListItem[]
  assignedLeads   SavedListItem[]  @relation("LeadAssignee")
  visitedLeads    SavedListItem[]  @relation("LeadVisitor")
  favoriteShows   FavoriteShow[]
  trustedDevices  TrustedDevice[]
  loginCodes      LoginCode[]
  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]
}

// A browser that has confirmed a login code from the user's email. It can log
// in with just the password until expiresAt. The raw token is in a cookie;
// only its SHA-256 hash is stored.
model TrustedDevice {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A 6-digit code emailed when someone logs in from a new device. Once the code
// (or, at sign-up, the password alone) is accepted, a one-time ticket is issued
// that Auth.js exchanges for the session.
model LoginCode {
  id           String    @id @default(cuid())
  userId       String
  codeHash     String?
  attempts     Int       @default(0)
  expiresAt    DateTime
  usedAt       DateTime?
  ticketHash   String?   @unique
  ticketUsedAt DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id   String @id @default(cuid())
  name String // company name
  slug String @unique // used in URLs: /a/<slug>

  // Profile
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  city         String?
  region       String?
  country      String? // ISO 3166-1 alpha-2, e.g. "DK"
  website      String?
  vatNumber    String? // e.g. Danish CVR number

  // Stripe: we only store Stripe ids. Card data lives in Stripe, never here.
  stripeCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships           Membership[]
  addedExhibitors       Exhibitor[]
  invitations           Invitation[]
  contacts              Contact[]
  features              OrganizationFeature[]
  featureAccess         FeatureAccess[]
  subscriptions         Subscription[]
  invoices              Invoice[]
  savedLists            SavedList[]
  favoriteShows         FavoriteShow[]
  hiddenRecommendations HiddenShowRecommendation[]
  supportTickets        SupportTicket[]
}

enum Role {
  OWNER // full control, including billing and deleting the account
  ADMIN // manage users, profile and features
  MEMBER // use the product
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  // Only a SHA-256 hash of the token is stored; the raw token is in the link.
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
}

// Contact people for an account. Exactly one can be primary (enforced by a
// partial unique index in the migration).
model Contact {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String
  phone          String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Features and billing (Stripe is the source of truth; these are mirrors kept
// up to date by webhooks)
// ---------------------------------------------------------------------------

// Who can see a feature. Only platform admins change this, on the super
// admin page. New features start OFF, so they stay hidden until switched on.
enum FeatureRollout {
  OFF // hidden from every customer account
  SELECTED // only the accounts listed in FeatureAccess
  EVERYONE // every account
}

// Catalog of features a customer can switch on.
model Feature {
  id            String         @id @default(cuid())
  key           String         @unique // stable code identifier, e.g. "lead-capture"
  name          String
  description   String?
  stripePriceId String? // the Stripe Price charged for this feature, if any
  rollout       FeatureRollout @default(OFF)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  organizations OrganizationFeature[]
  access        FeatureAccess[]
}

// Accounts a platform admin has given a feature to while its rollout is
// SELECTED (for example to try it out before everyone gets it).
model FeatureAccess {
  featureId      String
  organizationId String
  createdAt      DateTime @default(now())

  feature      Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([featureId, organizationId])
  @@index([organizationId])
}

// Which features an account has selected.
model OrganizationFeature {
  organizationId           String
  featureId                String
  stripeSubscriptionItemId String?  @unique
  enabledAt                DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feature      Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([organizationId, featureId])
}

model Subscription {
  id                   String    @id @default(cuid())
  organizationId       String
  stripeSubscriptionId String    @unique
  // Stripe status string: trialing, active, past_due, canceled, unpaid, ...
  status               String
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Invoice {
  id               String    @id @default(cuid())
  organizationId   String
  stripeInvoiceId  String    @unique
  number           String?
  // Stripe status string: draft, open, paid, uncollectible, void
  status           String
  currency         String
  amountDue        Int // smallest currency unit (øre / cents)
  amountPaid       Int
  hostedInvoiceUrl String?
  invoicePdfUrl    String?
  periodStart      DateTime?
  periodEnd        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Stripe webhook events already handled, so a re-delivered event is ignored.
model StripeEvent {
  id          String   @id // Stripe event id, e.g. evt_...
  type        String
  processedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Shared directory: the same lists for every account. Everyone who is logged
// in can read them; only platform admins (PLATFORM_ADMIN_EMAILS) change them.
// ---------------------------------------------------------------------------

model ExhibitionCenter {
  id               String    @id @default(cuid())
  name             String
  city             String?
  country          String? // ISO 3166-1 alpha-2, e.g. "DE"
  website          String?
  eventsUrl        String? // the center's own page listing its upcoming events
  eventsUrlTriedAt DateTime? // when AI last looked for the events page, so it isn't searched again
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // AI trade show finder: whether to check this center's events page, and
  // how the last check went.
  findShows       Boolean          @default(false)
  showsCheckedAt  DateTime?
  showsCheckError String?
  showsCheckNote  String? // what the last check found, e.g. "Found 12 trade shows on the page: 2 new, ..."
  showsFoundLast  Int?
  showsGroupId    String? // the finder's check group, e.g. "Europe"
  showsGroup      ShowFinderGroup? @relation(fields: [showsGroupId], references: [id], onDelete: SetNull)

  tradeShows     TradeShow[]
  suggestedShows SuggestedShow[]

  @@index([name])
  @@index([showsGroupId])
}

model ExhibitionOrganizer {
  id        String   @id @default(cuid())
  name      String // the organizer company
  website   String?
  country   String? // ISO 3166-1 alpha-2, e.g. "DE"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tradeShows TradeShow[]

  @@index([name])
}

// A trade show. Its status (upcoming, running, finished) is worked out from
// the dates when shown, so it is not stored.
model TradeShow {
  id                    String    @id @default(cuid())
  name                  String
  startDate             DateTime  @db.Date
  endDate               DateTime  @db.Date
  city                  String?
  country               String? // ISO 3166-1 alpha-2, e.g. "DE"
  website               String?
  exhibitorDirectoryUrl String? // the show's own list of exhibitors
  centerId              String? // where it takes place, if known
  organizerId           String? // who organizes it, if known
  organizerTriedAt      DateTime? // when AI last looked for the organizer, so it isn't searched again
  exhibitorsTriedAt     DateTime? // when "Fetch exhibitors for all shows" last tried this show, so it is not tried again on every run
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  center      ExhibitionCenter?          @relation(fields: [centerId], references: [id], onDelete: SetNull)
  organizer   ExhibitionOrganizer?       @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  exhibitors  Exhibitor[]
  suggestions SuggestedShow[]
  favoriteOf  FavoriteShow[]
  hiddenFrom  HiddenShowRecommendation[]

  @@index([startDate])
  @@index([name])
  @@index([centerId])
  @@index([organizerId])
}

// A company exhibiting at one trade show. The same company at two shows is
// two rows, since booth, contact and so on differ per show; rows with the same
// companyKey are shown as one company (see src/lib/company.ts).
model Exhibitor {
  id                    String    @id @default(cuid())
  tradeShowId           String
  name                  String // company name
  contactName           String?
  contactTitle          String?
  email                 String? // often missing when fetched from a show's exhibitor directory
  phone                 String?
  website               String?
  country               String? // ISO 3166-1 alpha-2, e.g. "DK"
  industry              String?
  boothNumber           String?
  standLocationUrl      String? // link to the booth on the show's floor plan
  companyProfile        String? // short description of the company
  profileTriedAt        DateTime? // when the AI last tried to write companyProfile from the website
  contactTriedAt        DateTime? // when the AI last looked for a contact person on the website
  hunterTriedAt         DateTime? // when Hunter.io was last asked for the company's contacts
  companyKey            String? // the same for every show's row of one company; null until worked out, e.g. after the name or website changed
  // The customer account that added it with "Add exhibitor"; that account may
  // edit and delete it. Null for imported rows, which only platform admins edit.
  addedByOrganizationId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tradeShow TradeShow       @relation(fields: [tradeShowId], references: [id], onDelete: Cascade)
  addedBy   Organization?   @relation(fields: [addedByOrganizationId], references: [id], onDelete: SetNull)
  savedIn   SavedListItem[]

  @@index([tradeShowId])
  @@index([addedByOrganizationId])
  @@index([name])
  @@index([companyKey])
  // The search box looks for its text anywhere in these.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Exhibitor_name_trgm_idx")
  @@index([contactName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Exhibitor_contactName_trgm_idx")
  @@index([industry(ops: raw("gin_trgm_ops"))], type: Gin, map: "Exhibitor_industry_trgm_idx")
}

// ---------------------------------------------------------------------------
// Saved lists: an account's own lists of exhibitors it wants to contact.
// Every member of the account sees and changes them; other accounts never do.
// ---------------------------------------------------------------------------

model SavedList {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  // The account's Favorites list (the star on the Exhibitors page). At most
  // one per account, enforced by a partial unique index in the migration. It
  // is created the first time a star is clicked and cannot be renamed or deleted.
  favorites      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        SavedListItem[]

  @@index([organizationId])
}

model SavedListItem {
  listId        String
  exhibitorId   String
  addedAt       DateTime   @default(now())
  addedById     String?
  // The exhibitor's details as the daily list email last reported them, so
  // the next email can tell what changed. Null until the first email has
  // reported the exhibitor as added.
  snapshot      Json?
  // Lead work on the Favorites page: how far the account has come with the
  // exhibitor, and its own notes. Only used on the Favorites list.
  leadStatus    LeadStatus @default(NEW)
  leadNote      String?
  leadUpdatedAt DateTime?
  // A reminder to follow up on the lead: the date it is due and a short text,
  // e.g. "Call again". Shown on the dashboard and in the daily email.
  followUpAt    DateTime?  @db.Date
  followUpNote  String?
  // The user in the account who is responsible for the lead; null when no one is.
  assigneeId    String?
  // Ticked off on the trade show's meeting plan: the booth has been visited.
  visitedAt     DateTime?
  visitedById   String?

  list      SavedList @relation(fields: [listId], references: [id], onDelete: Cascade)
  exhibitor Exhibitor @relation(fields: [exhibitorId], references: [id], onDelete: Cascade)
  addedBy   User?     @relation(fields: [addedById], references: [id], onDelete: SetNull)
  assignee  User?     @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  visitedBy User?     @relation("LeadVisitor", fields: [visitedById], references: [id], onDelete: SetNull)

  @@id([listId, exhibitorId])
  @@index([exhibitorId])
  @@index([assigneeId])
}

// How far an account has come with a favorite exhibitor (see src/lib/leads.ts).
enum LeadStatus {
  NEW
  CONTACTED
  MEETING
  WON
  LOST
}

// A trade show an account has starred on the Trade shows page. Every member of
// the account sees the same favorites; other accounts never do.
model FavoriteShow {
  organizationId String
  tradeShowId    String
  addedAt        DateTime  @default(now())
  addedById      String?
  // Exhibitors added to the show up to this time have been looked at for the
  // daily email's "New exhibitors you may like"; null until the first email.
  suggestedUntil DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tradeShow    TradeShow    @relation(fields: [tradeShowId], references: [id], onDelete: Cascade)
  addedBy      User?        @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@id([organizationId, tradeShowId])
  @@index([tradeShowId])
}

// ---------------------------------------------------------------------------
// AI trade show finder: reads the events pages of chosen exhibition centers
// once a month and adds the new trade shows it finds to the shared list.
// ---------------------------------------------------------------------------

// One row (id 1) with the switch and the result of the last run.
model ShowFinderSettings {
  id             Int       @id @default(1)
  enabled        Boolean   @default(false) // runs on its own when on
  lastRunAt      DateTime?
  lastRunSummary String?
  updatedAt      DateTime  @updatedAt
}

// A named group of centers for the AI trade show finder, e.g. "Europe". The
// whole group can be checked at once.
model ShowFinderGroup {
  id        String             @id @default(cuid())
  name      String             @unique
  createdAt DateTime           @default(now())
  centers   ExhibitionCenter[]
}

enum SuggestionStatus {
  PENDING // found before shows were added automatically; added on the next run
  APPROVED // added to the trade show list
  REJECTED // removed by a platform admin; kept so it is not added again
}

model SuggestedShow {
  id          String           @id @default(cuid())
  centerId    String
  name        String
  startDate   DateTime         @db.Date
  endDate     DateTime         @db.Date
  website     String?
  sourceUrl   String // the events page it was found on
  status      SuggestionStatus @default(PENDING)
  tradeShowId String? // the trade show it was added as
  createdAt   DateTime         @default(now())
  decidedAt   DateTime?

  center    ExhibitionCenter @relation(fields: [centerId], references: [id], onDelete: Cascade)
  tradeShow TradeShow?       @relation(fields: [tradeShowId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([centerId])
}

// ---------------------------------------------------------------------------
// Old trade show cleanup: once a day, trade shows that ended more than three
// years ago are deleted, with their exhibitors. One row (id 1).
// ---------------------------------------------------------------------------

model TradeShowCleanupSettings {
  id             Int       @id @default(1)
  enabled        Boolean   @default(false) // runs on its own when on
  lastRunAt      DateTime?
  lastRunDeleted Int? // trade shows deleted by the last run
  updatedAt      DateTime  @updatedAt
}

// A recommended trade show an account clicked "Not interested" on, so it is
// not recommended again (see src/lib/show-recommendations.ts).
model HiddenShowRecommendation {
  organizationId String
  tradeShowId    String
  hiddenAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tradeShow    TradeShow    @relation(fields: [tradeShowId], references: [id], onDelete: Cascade)

  @@id([organizationId, tradeShowId])
  @@index([tradeShowId])
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

enum SupportStatus {
  OPEN
  CLOSED
}

// A support request from a customer account: a subject and a thread of
// messages between the account's users and the platform admins.
model SupportTicket {
  id               String        @id @default(cuid())
  organizationId   String
  createdById      String?
  subject          String
  status           SupportStatus @default(OPEN)
  // The customer wrote last, so the ticket waits for an answer from support.
  waitingOnSupport Boolean       @default(true)
  // When the latest message was written; the lists are sorted by it.
  lastMessageAt    DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([organizationId, lastMessageAt])
  @@index([status, waitingOnSupport])
}

model SupportMessage {
  id          String   @id @default(cuid())
  ticketId    String
  authorId    String?
  // Written by a platform admin (shown as "Support") rather than by the customer.
  fromSupport Boolean  @default(false)
  body        String
  createdAt   DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}
