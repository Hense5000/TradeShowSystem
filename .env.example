# Copy this file to .env and fill in the values.

# PostgreSQL connection string (local: see docker-compose.yml)
DATABASE_URL="postgresql://app:app@localhost:5432/tradeshow"

# Secret used to sign login sessions. Generate one with: npx auth secret
AUTH_SECRET="replace-me"
# Needed when running `npm start` outside Vercel (Vercel sets this itself)
AUTH_TRUST_HOST=true

# Public URL of the app (used to build invitation links)
APP_URL="http://localhost:3000"

# Stripe (used from the billing step onwards; never store card data yourself)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
