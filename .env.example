# Copy this file to .env and fill in the values.

# PostgreSQL connection strings (local: see docker-compose.yml).
# On Vercel, the Neon integration sets both automatically.
DATABASE_URL="postgresql://app:app@localhost:5432/tradeshow"
DATABASE_URL_UNPOOLED="postgresql://app:app@localhost:5432/tradeshow"

# Secret used to sign login sessions. Generate one with: npx auth secret
AUTH_SECRET="replace-me"
# Needed when running `npm start` outside Vercel (Vercel sets this itself)
AUTH_TRUST_HOST=true

# Public URL of the app, used in invitation links.
# Optional on Vercel: it falls back to the project's production domain.
APP_URL="http://localhost:3000"

# Stripe (used from the billing step onwards; never store card data yourself)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Emails of the people who may edit the shared lists (exhibition centers and,
# later, trade shows, organizers and exhibitors), separated by commas.
PLATFORM_ADMIN_EMAILS=
