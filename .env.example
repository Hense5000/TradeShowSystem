# Copy this file to .env and fill in the values.

# PostgreSQL connection strings (local: see docker-compose.yml).
# On Vercel, the Neon integration sets both automatically.
DATABASE_URL="postgresql://app:app@localhost:5432/tradeshow"
DATABASE_URL_UNPOOLED="postgresql://app:app@localhost:5432/tradeshow"

# Secret used to sign login sessions. Generate one with: npx auth secret
AUTH_SECRET="replace-me"
# Needed when running `npm start` outside Vercel (Vercel sets this itself)
AUTH_TRUST_HOST=true

# Public URL of the app, used in invitation links.
# Optional on Vercel: it falls back to the project's production domain.
APP_URL="http://localhost:3000"

# Stripe (used from the billing step onwards; never store card data yourself)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Emails of the platform (super) admins, separated by commas. They edit the
# shared lists and switch features on and off on the Feature control page.
PLATFORM_ADMIN_EMAILS=

# AI trade show finder (Feature control → AI trade show finder).
# Key from https://console.anthropic.com. Without it the finder cannot read pages.
ANTHROPIC_API_KEY=
# Any long random text. Vercel sends it with the daily cron call (vercel.json),
# so only Vercel can start the automatic check.
CRON_SECRET=
# Optional: the Claude model that reads the pages (default claude-opus-5-5).
SHOW_FINDER_MODEL=
