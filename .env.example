# Copy this file to .env and fill in the values.

# PostgreSQL connection strings (local: see docker-compose.yml).
# On Vercel, the Neon integration sets both automatically.
DATABASE_URL="postgresql://app:app@localhost:5432/tradeshow"
DATABASE_URL_UNPOOLED="postgresql://app:app@localhost:5432/tradeshow"

# Secret used to sign login sessions. Generate one with: npx auth secret
AUTH_SECRET="replace-me"
# Needed when running `npm start` outside Vercel (Vercel sets this itself)
AUTH_TRUST_HOST=true

# Public URL of the app, used in invitation links.
# Optional on Vercel: it falls back to the project's production domain.
APP_URL="http://localhost:3000"

# Stripe subscriptions (Billing page). Card data lives in Stripe, never here.
# Secret key from Stripe → Developers → API keys (sk_test_... while testing).
STRIPE_SECRET_KEY=""
# Signing secret of the webhook https://<domain>/api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=""
# The Price of the subscription plan, from the product in Stripe (price_...).
STRIPE_PRICE_ID=""
# The Price of the upgraded plan (5 trade shows per day instead of 1), on the
# same product (price_...). Without it there is no Upgrade button.
STRIPE_PRO_PRICE_ID=""

# Emails of the platform (super) admins, separated by commas. They edit the
# shared lists and switch features on and off on the Feature control page.
PLATFORM_ADMIN_EMAILS=

# AI trade show finder (Feature control → AI trade show finder).
# Key from https://console.anthropic.com. Without it the finder cannot read pages.
ANTHROPIC_API_KEY=
# Any long random text. Vercel sends it with the daily cron call (vercel.json),
# so only Vercel can start the automatic check.
CRON_SECRET=
# Optional: the Claude model that reads the pages (default claude-opus-5-5).
SHOW_FINDER_MODEL=
# Optional: the Claude model that writes exhibitor company profiles (default claude-opus-5-5).
COMPANY_PROFILE_MODEL=
# Optional: the Claude model that finds exhibitor contact persons on their websites (default claude-opus-5-5).
CONTACT_FINDER_MODEL=
# Optional: Hunter.io key (https://hunter.io/api-keys). With it, "Find contact"
# and "Find missing contacts" also ask Hunter.io for names and emails the
# website does not show. Each company Hunter finds addresses for uses a credit.
HUNTER_API_KEY=
# Optional: the Claude model that finds exhibition centers' events pages (default claude-opus-5-5).
EVENTS_PAGE_MODEL=

# Email (the daily email about what is new on saved lists). Key from
# https://resend.com, and a sender on a domain verified there. Without them no
# email is sent.
RESEND_API_KEY=
EMAIL_FROM="Trade Show System <noreply@ngasoft.dk>"
# Optional: where new support requests and customer replies are emailed
# (default henrik1000@gmail.com).
SUPPORT_NOTIFY_EMAIL=

# Files on favorite exhibitors (quotes, presentations ...). Vercel sets this
# itself when a PRIVATE Blob store is connected to the project (Storage → Blob).
# Without it the Upload file area says uploads are not switched on yet.
BLOB_READ_WRITE_TOKEN=

# Login from a new device needs a 6-digit code sent by email (only when email is
# set up above). Set to "off" to switch that off, e.g. if email stops working.
LOGIN_DEVICE_CHECK=
